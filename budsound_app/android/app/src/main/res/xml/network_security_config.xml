<?xml version="1.0" encoding="utf-8"?>
<!--
  Permite tráfico HTTP sin cifrar SOLO hacia el backend de desarrollo
  (10.0.2.2 = cómo el emulador Android ve "localhost" de la máquina host,
  ver ApiConfig._host). Desde Android 9 (API 28) el WebView del sistema
  bloquea cleartext por defecto — el `http.post` que hace Flutter desde
  Dart (package:http) no pasa por esta restricción porque no usa el stack
  de red de Android, pero el `fetch()` que corre DENTRO del WebView del
  pago (ver checkout.controller.js) sí, y fallaba en silencio sin ningún
  error visible ("Procesando pago..." colgado para siempre).

  No es un `usesCleartextTraffic="true"` global: sigue bloqueado para
  cualquier otro dominio. En producción (Railway, HTTPS) esto no aplica —
  ver ApiConfig._usarProduccion.
-->
<network-security-config>
  <domain-config cleartextTrafficPermitted="true">
    <domain includeSubdomains="false">10.0.2.2</domain>
    <domain includeSubdomains="false">localhost</domain>
  </domain-config>
</network-security-config>
