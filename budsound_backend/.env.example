# Servidor
PORT=3000
NODE_ENV=development
CORS_ORIGIN=*

# PostgreSQL
DATABASE_URL=postgresql://usuario:password@localhost:5432/budsound

# Auth
JWT_SECRET=cambia-este-secreto-en-produccion
JWT_EXPIRES_IN=7d

# Login con Google (placeholder hasta crear el proyecto en Google Cloud
# Console). Es el Client ID tipo "Web", el mismo valor que la app Flutter
# usa como GOOGLE_SERVER_CLIENT_ID — ver CLAUDE.md para la guía de setup.
GOOGLE_CLIENT_ID=

# Correo de verificación al registrarse (ver email.service.js). Mientras
# estas variables estén vacías, el registro NO exige verificar el correo
# (igual que MercadoPago/Google: sin credenciales, esa capa queda apagada).
# Con Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=tu correo,
# SMTP_PASS=una "contraseña de aplicación" (no tu contraseña normal de Gmail).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=BudSound <no-reply@budsound.app>

# URL pública de este backend, para armar el link del correo de
# verificación. En Railway: el dominio de "Networking -> Generate Domain"
# (ver RAILWAY_DEPLOY.md), con https://.
PUBLIC_URL=http://localhost:3000

# MercadoPago (placeholder hasta tener credenciales de sandbox)
MERCADOPAGO_ACCESS_TOKEN=TEST-PLACEHOLDER-ACCESS-TOKEN
MERCADOPAGO_PUBLIC_KEY=TEST-PLACEHOLDER-PUBLIC-KEY

# OAuth de MercadoPago como marketplace: permite que cada DJ conecte su
# propia cuenta (ver mercadopago-oauth.service.js) para que las propinas le
# lleguen directo a él, menos la comisión de BudSound. Son credenciales
# DISTINTAS del Access Token/Public Key de arriba — están en la pestaña
# "OAuth" de las credenciales de tu aplicación en el panel de MercadoPago.
# Mientras falten, el botón "Conectar MercadoPago" del DJ queda
# deshabilitado y las propinas se cobran en la cuenta central (como ahora).
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=

# Comisión BudSound sobre lo recaudado (0.05 = 5%)
BUDSOUND_COMMISSION_RATE=0.08

# Limpieza de solicitudes colgadas (ver CLAUDE.md, riesgo "Autorización de
# pago vs. captura"): cada cuánto corre el barrido y a partir de cuántas
# horas sin respuesta del DJ se cancela una solicitud pendiente.
REQUEST_TIMEOUT_HOURS=6
CLEANUP_INTERVAL_MINUTES=15
